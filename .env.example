# Copy to .env only if you want to override docker-compose defaults.
# The application boots without a real OpenAI key.

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=flowops
DATABASE_PASSWORD=flowops
DATABASE_NAME=flowops_development

REDIS_URL=redis://redis:6379/0
SECRET_KEY_BASE=dev-only-secret-key-base
PAYMENTS_WEBHOOK_TOKEN=dev-webhook-token

# mock | openai
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3000
